# backend/.env  (never commit the real file). Settings → Keys in the app writes this file for you.
# How to get each key: see "API keys" in README.md.
TMDB_TOKEN=            # Movies and Shows: TMDB "API Read Access Token" (the long eyJ... one), themoviedb.org → Settings → API
RAWG_KEY=              # Games: rawg.io/apidocs → Get API Key
OMDB_KEY=              # optional, Movies: omdbapi.com/apikey.aspx (free tier); IMDb / Rotten Tomatoes / Metacritic scores
HARDCOVER_TOKEN=       # optional, Books: hardcover.app → Account → API; series, release dates and missing book details
GOOGLE_BOOKS_KEY=      # optional, Books: Google Cloud console → enable Books API → Credentials → API key
CONTACT_EMAIL=         # optional, Shows/Books: sent in the User-Agent to Open Library and TVmaze (they ask for one)
DATA_DIR=./data        # movies.db, media/, models/
