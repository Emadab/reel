# backend/.env  (never commit the real file)
TMDB_TOKEN=            # TMDB "API Read Access Token" (v4 bearer), from themoviedb.org → Settings → API
OMDB_KEY=              # optional, omdbapi.com; enables IMDb / Rotten Tomatoes / Metacritic scores
RAWG_KEY=              # optional, rawg.io/apidocs; games (metadata, covers, playtime)
GOOGLE_BOOKS_KEY=      # optional, Google Cloud console; fallback book descriptions and page counts
HARDCOVER_TOKEN=       # optional, hardcover.app → Settings → API; book series and release dates
CONTACT_EMAIL=         # optional, sent in the User-Agent to Open Library and TVmaze (they ask for one)
DATA_DIR=./data        # movies.db, media/, models/
